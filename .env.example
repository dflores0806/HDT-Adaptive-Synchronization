# Defaults below are for isolated LOCAL research deployment only.
MW_IMAGE=hdt-middleware:revision
POSTGRES_USER=hdt
POSTGRES_PASSWORD=hdt
POSTGRES_DB=hdt
POSTGRES_DSN=postgresql+psycopg2://hdt:hdt@postgres:5432/hdt
MQTT_BROKER=mosquitto
MQTT_PORT=1883
REDIS_URL=redis://redis:6379/0
API_URL=http://middleware:8000
HEARTBEAT_STALE_S=7
CONTROL_PERIOD_S=2
ACTION_GRID_S=1,2,4,8
AOI_MAX_S=12
ERROR_MAX_NORM=0.08
COMM_BUDGET_BPS=6000
ENERGY_BUDGET_JPS=6
LATENCY_MAX_MS=120
W_COMM=0.35
W_ENERGY=0.15
W_ERROR=0.35
W_AOI=0.15

# Dedicated isolated benchmarking project (avoid collisions with other Docker projects)
HDT_COMPOSE_PROJECT=hdt_iotj26
HDT_API_PORT=18000
HDT_PG_PORT=55432
HDT_MQTT_PORT=18883
HDT_API_BASE=http://127.0.0.1:18000
